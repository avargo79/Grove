<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Grove.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="340"
             x:Class="Grove.App.Views.WorkingCopyView"
             x:DataType="vm:WorkingCopyViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="WorkingFileTemplate" DataType="vm:WorkingFileViewModel">
            <Grid ColumnDefinitions="16,*" ToolTip.Tip="{Binding ToolTip}">
                <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}"
                           Classes="status"
                           Classes.added="{Binding IsAdded}"
                           Classes.deleted="{Binding IsDeleted}"
                           Classes.renamed="{Binding IsRenamed}"
                           Classes.conflict="{Binding IsConflict}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
                    <TextBlock Text="{Binding Directory}"
                               IsVisible="{Binding HasDirectory}"
                               Foreground="{DynamicResource DimBrush}"
                               TextTrimming="CharacterEllipsis" FontSize="11" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid ColumnDefinitions="320,4,*,4,300" Background="{DynamicResource PanelBackgroundBrush}">

        <!-- Staged over unstaged, the way Fork splits the index -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,*">

            <Border Grid.Row="0" Padding="12,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Staged" Classes="sectionheader" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Unstage All" Classes="link"
                            Command="{Binding UnstageAllCommand}"
                            IsVisible="{Binding HasStagedFiles}" />
                </Grid>
            </Border>

            <ListBox Grid.Row="1" Name="StagedList" Classes="flat"
                     ItemsSource="{Binding StagedFiles}"
                     ItemTemplate="{DynamicResource WorkingFileTemplate}"
                     SelectionChanged="OnStagedSelectionChanged"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Unstage"
                                  Command="{Binding UnstageFileCommand}"
                                  CommandParameter="{Binding SelectedFile}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <Border Grid.Row="2" Padding="12,6"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Unstaged" Classes="sectionheader" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Stage All" Classes="link"
                            Command="{Binding StageAllCommand}" />
                </Grid>
            </Border>

            <ListBox Grid.Row="3" Name="UnstagedList" Classes="flat"
                     ItemsSource="{Binding UnstagedFiles}"
                     ItemTemplate="{DynamicResource WorkingFileTemplate}"
                     SelectionChanged="OnUnstagedSelectionChanged"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Stage"
                                  Command="{Binding StageFileCommand}"
                                  CommandParameter="{Binding SelectedFile}" />
                        <Separator />
                        <MenuItem Header="Discard Changes…"
                                  Command="{Binding DiscardFileCommand}"
                                  CommandParameter="{Binding SelectedFile}" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <!-- Diff with hunk and line staging -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" Background="{DynamicResource RowBackgroundBrush}">

            <Border Grid.Row="0" Padding="8,5"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Name="StageLinesButton" Content="Stage Lines"
                            Command="{Binding StageSelectedLinesCommand}" FontSize="11.5" />
                    <Button Name="UnstageLinesButton" Content="Unstage Lines"
                            Command="{Binding UnstageSelectedLinesCommand}" FontSize="11.5" />
                    <TextBlock Text="Select lines in the diff, or use a hunk's own button."
                               Foreground="{DynamicResource DimBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DeletedBrush}" FontSize="11"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1" Name="DiffList" Classes="diff"
                     ItemsSource="{Binding DiffRows}"
                     SelectionMode="Multiple"
                     SelectionChanged="OnDiffSelectionChanged"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:DiffRowViewModel">
                        <Border Classes="diffline"
                                Classes.added="{Binding IsAdded}"
                                Classes.removed="{Binding IsRemoved}"
                                Classes.hunk="{Binding IsHunkHeader}">
                            <StackPanel Orientation="Horizontal">
                                <!-- Per-hunk staging leads the heading row: right-aligning it would
                                     scroll out of view with the diff's horizontal scrollbar. -->
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            Margin="2,0,6,0" IsVisible="{Binding IsHunkHeader}">
                                    <Button Content="Stage Hunk" Classes="link" FontSize="10.5"
                                            Command="{Binding $parent[UserControl].((vm:WorkingCopyViewModel)DataContext).StageHunkCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Unstage Hunk" Classes="link" FontSize="10.5"
                                            Command="{Binding $parent[UserControl].((vm:WorkingCopyViewModel)DataContext).UnstageHunkCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>

                                <TextBlock Text="{Binding OldNumber}" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource DiffGutterBrush}" FontSize="11.5" Padding="4,0,0,0"
                                           IsVisible="{Binding !IsHunkHeader}" />
                                <TextBlock Text="{Binding NewNumber}" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource DiffGutterBrush}" FontSize="11.5" Padding="6,0,8,0"
                                           IsVisible="{Binding !IsHunkHeader}" />
                                <TextBlock Text="{Binding Marker}" FontFamily="{StaticResource MonoFont}"
                                           Classes="difftext"
                                           Classes.added="{Binding IsAdded}"
                                           Classes.removed="{Binding IsRemoved}" FontSize="11.5"
                                           IsVisible="{Binding !IsHunkHeader}" />
                                <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                                           Classes="difftext"
                                           Classes.added="{Binding IsAdded}"
                                           Classes.removed="{Binding IsRemoved}"
                                           Classes.hunk="{Binding IsHunkHeader}"
                                           Classes.header="{Binding IsHeader}" FontSize="11.5" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="3" Background="{DynamicResource BorderBrush}" />

        <!-- Commit box -->
        <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto,Auto" Margin="10">

            <TextBlock Grid.Row="0" Text="Commit message" Classes="sectionheader" Margin="0,0,0,6" />

            <TextBox Grid.Row="1" Name="CommitMessageBox"
                     Text="{Binding CommitMessage, Mode=TwoWay}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     PlaceholderText="Summary, then a blank line, then details"
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalContentAlignment="Top" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8">
                <CheckBox Name="AmendCheckBox" Content="Amend last commit"
                          IsChecked="{Binding IsAmending, Mode=TwoWay}" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="6">
                <Button Name="CommitButton"
                        Content="{Binding CommitButtonText}"
                        Command="{Binding CommitCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" />

                <Expander Header="Recent messages" FontSize="11" IsExpanded="False">
                    <ItemsControl ItemsSource="{Binding RecentMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="x:String">
                                <Button Content="{Binding}" Classes="link" FontSize="11"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Command="{Binding $parent[ItemsControl].((vm:WorkingCopyViewModel)DataContext).UseRecentMessageCommand}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
