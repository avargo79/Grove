<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Grove.App.App"
             xmlns:local="using:Grove.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!--
              Every colour lives in both dictionaries so the whole app can switch at runtime.
              The keys are identical; only the values differ, which is what lets the rest of the
              XAML stay theme-agnostic.
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <!-- Surfaces, darkest to lightest. Only three levels: any more and the eye
                         starts reading the chrome instead of the code. -->
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#15171C" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#1A1D23" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#1A1D23" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#101216" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#272B33" />

                    <SolidColorBrush x:Key="ForegroundBrush" Color="#E3E6EB" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#98A1AE" />
                    <SolidColorBrush x:Key="DimBrush" Color="#6A7381" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />

                    <!-- Selection is a tint rather than a fill: a saturated bar across a dense
                         list drowns out the ref badges and lane colours it sits among. -->
                    <SolidColorBrush x:Key="SelectionBrush" Color="#1F3054" />
                    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#2F4C86" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#22262F" />
                    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A404B" />

                    <SolidColorBrush x:Key="AddedBrush" Color="#68C97B" />
                    <SolidColorBrush x:Key="DeletedBrush" Color="#F0736A" />
                    <SolidColorBrush x:Key="ModifiedBrush" Color="#E0AC4E" />
                    <SolidColorBrush x:Key="RenamedBrush" Color="#7C9EE8" />
                    <SolidColorBrush x:Key="ConflictBrush" Color="#E05D7C" />

                    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#12301E" />
                    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#361A1A" />
                    <SolidColorBrush x:Key="DiffHunkBackgroundBrush" Color="#1C2129" />
                    <SolidColorBrush x:Key="DiffGutterBrush" Color="#565D69" />
                    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#9BDCA0" />
                    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#F5A6A0" />

                    <SolidColorBrush x:Key="WordHighlightBrush" Color="#3A455A" />
                    <SolidColorBrush x:Key="WordAddedHighlightBrush" Color="#2A6B36" />
                    <SolidColorBrush x:Key="WordRemovedHighlightBrush" Color="#7A2F2F" />

                    <SolidColorBrush x:Key="BadgeHeadBrush" Color="#2B4C87" />
                    <SolidColorBrush x:Key="BadgeLocalBrush" Color="#333B4A" />
                    <SolidColorBrush x:Key="BadgeRemoteBrush" Color="#31353D" />
                    <SolidColorBrush x:Key="BadgeTagBrush" Color="#54452A" />
                    <SolidColorBrush x:Key="BadgeUnreachableBrush" Color="#5F3628" />

                    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#33261440" />
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#26FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#DFE2E7" />

                    <SolidColorBrush x:Key="ForegroundBrush" Color="#1B1F26" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5B6472" />
                    <SolidColorBrush x:Key="DimBrush" Color="#8A929E" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#1F63DA" />

                    <SolidColorBrush x:Key="SelectionBrush" Color="#DCE8FC" />
                    <SolidColorBrush x:Key="SelectionBorderBrush" Color="#A9C6F5" />
                    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EAECF0" />
                    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C8D0" />

                    <SolidColorBrush x:Key="AddedBrush" Color="#1F7A32" />
                    <SolidColorBrush x:Key="DeletedBrush" Color="#C0392B" />
                    <SolidColorBrush x:Key="ModifiedBrush" Color="#9A6700" />
                    <SolidColorBrush x:Key="RenamedBrush" Color="#2F5FB5" />
                    <SolidColorBrush x:Key="ConflictBrush" Color="#B02A50" />

                    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#E4F6E8" />
                    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#FBE7E7" />
                    <SolidColorBrush x:Key="DiffHunkBackgroundBrush" Color="#EDF1F7" />
                    <SolidColorBrush x:Key="DiffGutterBrush" Color="#9AA1AB" />
                    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#12602A" />
                    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#A02020" />

                    <SolidColorBrush x:Key="WordHighlightBrush" Color="#CBD9EE" />
                    <SolidColorBrush x:Key="WordAddedHighlightBrush" Color="#A8E4B6" />
                    <SolidColorBrush x:Key="WordRemovedHighlightBrush" Color="#F2B8B8" />

                    <SolidColorBrush x:Key="BadgeHeadBrush" Color="#C7DCFB" />
                    <SolidColorBrush x:Key="BadgeLocalBrush" Color="#E1E6EE" />
                    <SolidColorBrush x:Key="BadgeRemoteBrush" Color="#E8EAEE" />
                    <SolidColorBrush x:Key="BadgeTagBrush" Color="#F6E6C3" />
                    <SolidColorBrush x:Key="BadgeUnreachableBrush" Color="#F7DCCC" />

                    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#FDF5E2" />
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#1A000000" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono,Menlo,Consolas,DejaVu Sans Mono,monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Every window carries the mark, not just the main one: on Windows each top-level
             window gets its own taskbar entry, and an unset icon there falls back to a blank. -->
        <Style Selector="Window">
            <Setter Property="Icon" Value="/Assets/grove.png" />
        </Style>

        <!--
          Chrome controls. Fluent's defaults are sized for touch and shout at this density, so
          everything here is flattened to one height, one radius and one hairline border, and
          colour is spent only on state.
        -->
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource DimBrush}" />
        </Style>

        <Style Selector="SplitButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Inputs sit *below* the surface they are on, which is what makes them read as
             something to type into rather than something to press. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}" />
        </Style>
        <Style Selector="TextBox /template/ Border#PART_BorderElement">
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Thin, unobtrusive scrollbars: the content is the point. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="ScrollBar /template/ Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollThumbBrush}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- The splitter is a grab handle, not a divider: the panels either side draw their own
             hairline, and a 4px painted bar between them reads as a seam. -->
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>

        <!-- Tabs: an underline, not a folder tab. One repository is current; the rest are just
             names until you click them. -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" />
        </Style>
        <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ButtonSpinner /template/ RepeatButton">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <!-- A strip of related controls: one border around the group instead of one per control. -->
        <Style Selector="Border.controlgroup">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <!-- The one filled button in a view: the action that view exists for. Everything else
             stays outlined, so "which button commits" needs no reading. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style Selector="Button.primary /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource DimBrush}" />
        </Style>

        <!-- Compact chrome for dense strips: the diff options bar, the filter row. -->
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="TextBox.compact">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <!-- Commit list rows: flat, tight, keyboard-friendly. -->
        <Style Selector="ListBox.commits ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Height" Value="27" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ListBox.commits ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="ListBox.commits ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <Style Selector="ListBox.flat ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="25" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="ListBox.flat ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>

        <!-- Diff rows must not respond to hover/selection: the diff is read-only text. -->
        <Style Selector="ListBox.diff ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Ref badge colours by kind. -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource BadgeLocalBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge.head">
            <Setter Property="Background" Value="{DynamicResource BadgeHeadBrush}" />
        </Style>
        <Style Selector="Border.badge.remote">
            <Setter Property="Background" Value="{DynamicResource BadgeRemoteBrush}" />
        </Style>
        <Style Selector="Border.badge.unreachable">
            <Setter Property="Background" Value="{DynamicResource BadgeUnreachableBrush}" />
        </Style>
        <Style Selector="Border.badge.tag">
            <Setter Property="Background" Value="{DynamicResource BadgeTagBrush}" />
        </Style>

        <!-- File status letters. -->
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.added">
            <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.deleted">
            <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.renamed">
            <Setter Property="Foreground" Value="{DynamicResource RenamedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.conflict">
            <Setter Property="Foreground" Value="{DynamicResource ConflictBrush}" />
        </Style>

        <!-- Diff line backgrounds. -->
        <Style Selector="Border.diffline.added">
            <Setter Property="Background" Value="{DynamicResource DiffAddedBackgroundBrush}" />
        </Style>
        <Style Selector="Border.diffline.removed">
            <Setter Property="Background" Value="{DynamicResource DiffRemovedBackgroundBrush}" />
        </Style>
        <Style Selector="Border.diffline.hunk">
            <Setter Property="Background" Value="{DynamicResource DiffHunkBackgroundBrush}" />
        </Style>

        <Style Selector="TextBlock.difftext.added">
            <Setter Property="Foreground" Value="{DynamicResource DiffAddedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.difftext.removed">
            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.difftext.hunk">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.difftext.header">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <!-- Inline text actions: a button that reads as a link, not a chrome button. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Operation feedback in the status bar: neutral by default, red when it failed. -->
        <Style Selector="TextBlock.opstatus">
            <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
        </Style>
        <Style Selector="TextBlock.opstatus.error">
            <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}" />
        </Style>
        <Style Selector="TextBlock.opstatus.conflict">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <!-- Rebase plan rows: the chosen action changes how the subject reads. -->
        <Style Selector="TextBlock.rebasesubject.dropped">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="TextBlock.rebasesubject.combined">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.rebasesubject.stops">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <Style Selector="TextBlock.reflogaction">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.reflogaction.destructive">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <!-- Signature indicators. -->
        <Style Selector="TextBlock.signature">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>
        <Style Selector="TextBlock.signature.good">
            <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
        </Style>
        <Style Selector="TextBlock.signature.bad">
            <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}" />
        </Style>

        <Style Selector="TextBlock.substate">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.substate.attention">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <!-- Section headers are labels, not content: small, spaced out, and quiet. -->
        <Style Selector="TextBlock.sectionheader">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
    </Application.Styles>
</Application>
