<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitFork.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="400"
        x:Class="GitFork.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Settings">

    <StackPanel Margin="18" Spacing="14">
        <TextBlock Text="Appearance" Classes="sectionheader" />
        <CheckBox Name="LightThemeToggle" Content="Use the light theme"
                  IsChecked="{Binding IsLightTheme, Mode=TwoWay}" />

        <TextBlock Text="Diff" Classes="sectionheader" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Context lines"
                       VerticalAlignment="Center" FontSize="12" />
            <NumericUpDown Grid.Row="0" Grid.Column="1" Name="ContextSetting"
                           Value="{Binding DiffContextLines, Mode=TwoWay}"
                           Minimum="0" Maximum="50" Increment="1" FormatString="0" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Whitespace"
                       VerticalAlignment="Center" FontSize="12" Margin="0,8,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="WhitespaceSetting"
                      SelectedIndex="{Binding WhitespaceIndex, Mode=TwoWay}"
                      HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <ComboBoxItem Content="Show whitespace changes" />
                <ComboBoxItem Content="Ignore whitespace changes" />
                <ComboBoxItem Content="Ignore all whitespace" />
                <ComboBoxItem Content="Ignore blank lines" />
            </ComboBox>
        </Grid>

        <CheckBox Name="SyntaxSetting" Content="Syntax highlighting"
                  IsChecked="{Binding ShowSyntaxHighlighting, Mode=TwoWay}" />
        <CheckBox Name="WordSetting" Content="Word-level highlighting"
                  IsChecked="{Binding ShowWordHighlighting, Mode=TwoWay}" />

        <TextBlock Text="History" Classes="sectionheader" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="150,*">
            <TextBlock Grid.Column="0" Text="Commits per page"
                       VerticalAlignment="Center" FontSize="12" />
            <NumericUpDown Grid.Column="1" Name="PageSizeSetting"
                           Value="{Binding CommitPageSize, Mode=TwoWay}"
                           Minimum="50" Maximum="20000" Increment="50" FormatString="0" />
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="CancelSettingsButton" Content="Cancel" IsCancel="True"
                    Command="{Binding CancelCommand}" />
            <Button Name="SaveSettingsButton" Content="Save" IsDefault="True"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
