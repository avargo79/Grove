<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitFork.App.ViewModels"
        xmlns:controls="using:GitFork.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="GitFork.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        Width="1400" Height="900"
        Title="GitFork">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Command="{Binding OpenRepositoryCommand}"
                        Content="Open Repository…" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" Spacing="4"
                            IsVisible="{Binding HasRepository}">
                    <Button Name="FetchButton" Content="Fetch"
                            Command="{Binding Commands.FetchCommand}" />
                    <SplitButton Name="PullButton" Content="Pull"
                                 Command="{Binding Commands.PullCommand}">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Pull (rebase)" Command="{Binding Commands.PullRebaseCommand}" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <SplitButton Name="PushButton" Content="Push"
                                 Command="{Binding Commands.PushCommand}">
                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Force push (with lease)…"
                                          Command="{Binding Commands.ForcePushCommand}" />
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>
                    <Button Content="Stash" Command="{Binding Commands.StashPushCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" />
                    <TextBlock Text="·" Foreground="{StaticResource DimBrush}"
                               IsVisible="{Binding HasRepository}" />
                    <TextBlock Text="{Binding CurrentBranch}" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Commands.ProgressText}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" />
                    <Button Content="Cancel" Classes="link" FontSize="11"
                            Command="{Binding Commands.CancelNetworkOperationCommand}"
                            IsVisible="{Binding Commands.IsNetworkOperationRunning}" />
                    <ProgressBar IsIndeterminate="True" Width="90" Height="3"
                                 IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- In-progress merge or rebase: offer the way out before anything else -->
        <Border DockPanel.Dock="Top" Name="ConflictBanner"
                IsVisible="{Binding Commands.IsOperationInProgress}"
                Background="#3A2A18"
                BorderBrush="{StaticResource ModifiedBrush}" BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- One label in the star column: an Auto column sized this text to zero width
                     because the binding had no source until a repository was opened. -->
                <TextBlock Grid.Column="0" Name="BannerLabel"
                           Text="{Binding Commands.BannerText}"
                           Foreground="{StaticResource ForegroundBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Name="ContinueButton" Content="Continue"
                        Command="{Binding Commands.ContinueOperationCommand}" Margin="8,0,6,0" />
                <Button Grid.Column="2" Name="AbortButton" Content="Abort…"
                        Command="{Binding Commands.AbortOperationCommand}" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock Name="OperationStatus" Text="{Binding Commands.StatusText}" FontSize="11"
                               Classes="opstatus"
                               Classes.error="{Binding Commands.IsError}"
                               Classes.conflict="{Binding Commands.IsOperationInProgress}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RepositoryPath}"
                           Foreground="{StaticResource DimBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" MaxWidth="500" />
            </Grid>
        </Border>

        <!-- Sidebar | commits + detail -->
        <Grid ColumnDefinitions="240,4,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SidebarSectionViewModel">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}"
                                               Classes="sectionheader"
                                               Margin="12,4,0,4" />
                                    <ListBox Classes="flat"
                                             ItemsSource="{Binding Items}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionChanged="OnSidebarSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:SidebarItemViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Margin="{Binding IndentMargin}">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Checkout"
                                                                      IsVisible="{Binding IsCheckoutable}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.CheckoutRefCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Merge into current branch"
                                                                      IsVisible="{Binding CanBeMergedIn}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.MergeRefCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Rebase current branch onto this…"
                                                                      IsVisible="{Binding CanBeMergedIn}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.RebaseOntoRefCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <Separator IsVisible="{Binding IsLocalBranch}" />
                                                            <MenuItem Header="Rename…"
                                                                      IsVisible="{Binding IsLocalBranch}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.RenameBranchCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Delete…"
                                                                      IsVisible="{Binding IsLocalBranch}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.DeleteBranchCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Delete on remote…"
                                                                      IsVisible="{Binding IsRemoteBranch}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.DeleteRemoteBranchCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Delete tag…"
                                                                      IsVisible="{Binding IsTag}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.DeleteTagCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Apply"
                                                                      IsVisible="{Binding IsStash}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.StashApplyCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Pop"
                                                                      IsVisible="{Binding IsStash}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.StashPopCommand}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Drop…"
                                                                      IsVisible="{Binding IsStash}"
                                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.StashDropCommand}"
                                                                      CommandParameter="{Binding}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Ref.FullName}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TrackingDisplay}"
                                                               IsVisible="{Binding HasTracking}"
                                                               FontSize="11"
                                                               Margin="6,0,0,0"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <!-- Commit graph over detail pane -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,4,340">

                <!-- Pinned working-copy row: always the first thing in the history column -->
                <Border Grid.Row="0" Name="UncommittedRow"
                        IsVisible="{Binding HasUncommittedChanges}"
                        Background="{StaticResource RowBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                        Padding="0" Height="30"
                        PointerPressed="OnUncommittedRowPressed">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="12" Height="12" Margin="10,0,10,0"
                                CornerRadius="6" VerticalAlignment="Center"
                                BorderThickness="1.5" BorderBrush="{StaticResource ModifiedBrush}" />
                        <TextBlock Grid.Column="1" Text="Uncommitted changes"
                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Grid.Column="2" Text="{Binding UncommittedSummary}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                    </Grid>
                </Border>

                <!-- Commit list -->
                <ListBox Grid.Row="1"
                         Name="CommitList"
                         Classes="commits"
                         ItemsSource="{Binding Commits}"
                         SelectedItem="{Binding SelectedCommit}"
                         Background="{StaticResource RowBackgroundBrush}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:CommitRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,150,110,70" VerticalAlignment="Stretch">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Checkout this commit"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.CheckoutCommitCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Create branch here…"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.CreateBranchCommand}"
                                                  CommandParameter="{Binding Sha}" />
                                        <MenuItem Header="Create tag here…"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.CreateTagCommand}"
                                                  CommandParameter="{Binding Sha}" />
                                        <Separator />
                                        <MenuItem Header="Cherry-pick onto current branch"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.CherryPickCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="Revert"
                                                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.RevertCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="Reset current branch to here">
                                            <MenuItem Header="Soft — keep changes staged"
                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.ResetSoftCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Mixed — keep changes unstaged"
                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.ResetMixedCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Hard — discard all changes…"
                                                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Commands.ResetHardCommand}"
                                                      CommandParameter="{Binding}" />
                                        </MenuItem>
                                    </ContextMenu>
                                </Grid.ContextMenu>

                                <controls:GraphRowControl Grid.Column="0"
                                                          Row="{Binding GraphRow}"
                                                          Width="{Binding GraphWidth}"
                                                          DotBackground="{StaticResource RowBackgroundBrush}"
                                                          Margin="4,0,6,0" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Spacing="0">
                                    <ItemsControl ItemsSource="{Binding Badges}"
                                                  IsVisible="{Binding HasBadges}"
                                                  Margin="0,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:RefBadgeViewModel">
                                                <Border Classes="badge"
                                                        Classes.head="{Binding IsHead}"
                                                        Classes.remote="{Binding IsRemote}"
                                                        Classes.tag="{Binding IsTag}">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Subject}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding AuthorName}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="12" />

                                <TextBlock Grid.Column="3" Text="{Binding DateDisplay}"
                                           ToolTip.Tip="{Binding DateTooltip}"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" FontSize="12" />

                                <TextBlock Grid.Column="4" Text="{Binding ShortSha}"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center" FontSize="11.5" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="2" Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch" />

                <!-- Either the selected commit or the working copy, resolved by ViewLocator -->
                <ContentControl Grid.Row="3" Content="{Binding DetailContent}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
