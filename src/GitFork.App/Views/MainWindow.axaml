<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitFork.App.ViewModels"
        xmlns:controls="using:GitFork.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="GitFork.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}"
        Width="1400" Height="900"
        Title="GitFork">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,7">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Button Grid.Column="0"
                        Command="{Binding OpenRepositoryCommand}"
                        Content="Open Repository…" />

                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding HasRepository}"
                        Content="Refresh" />

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding RepositoryName}" FontWeight="SemiBold" />
                    <TextBlock Text="·" Foreground="{StaticResource DimBrush}"
                               IsVisible="{Binding HasRepository}" />
                    <TextBlock Text="{Binding CurrentBranch}" Foreground="{StaticResource AccentBrush}" />
                </StackPanel>

                <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="90" Height="3"
                             IsVisible="{Binding IsBusy}" />
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource ToolbarBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" />
                <TextBlock Grid.Column="1" Text="{Binding RepositoryPath}"
                           Foreground="{StaticResource DimBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis" MaxWidth="500" />
            </Grid>
        </Border>

        <!-- Sidebar | commits + detail -->
        <Grid ColumnDefinitions="240,4,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Sections}" Margin="0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SidebarSectionViewModel">
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Title}"
                                               Classes="sectionheader"
                                               Margin="12,4,0,4" />
                                    <ListBox Classes="flat"
                                             ItemsSource="{Binding Items}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             SelectionChanged="OnSidebarSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:SidebarItemViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Margin="{Binding IndentMargin}">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Ref.FullName}" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding TrackingDisplay}"
                                                               IsVisible="{Binding HasTracking}"
                                                               FontSize="11"
                                                               Margin="6,0,0,0"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Background="{StaticResource BorderBrush}" />

            <!-- Commit graph over detail pane -->
            <Grid Grid.Column="2" RowDefinitions="*,4,340">

                <!-- Commit list -->
                <ListBox Grid.Row="0"
                         Name="CommitList"
                         Classes="commits"
                         ItemsSource="{Binding Commits}"
                         SelectedItem="{Binding SelectedCommit}"
                         Background="{StaticResource RowBackgroundBrush}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:CommitRowViewModel">
                            <Grid ColumnDefinitions="Auto,*,150,110,70" VerticalAlignment="Stretch">

                                <controls:GraphRowControl Grid.Column="0"
                                                          Row="{Binding GraphRow}"
                                                          Width="{Binding GraphWidth}"
                                                          DotBackground="{StaticResource RowBackgroundBrush}"
                                                          Margin="4,0,6,0" />

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Spacing="0">
                                    <ItemsControl ItemsSource="{Binding Badges}"
                                                  IsVisible="{Binding HasBadges}"
                                                  Margin="0,0,4,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:RefBadgeViewModel">
                                                <Border Classes="badge"
                                                        Classes.head="{Binding IsHead}"
                                                        Classes.remote="{Binding IsRemote}"
                                                        Classes.tag="{Binding IsTag}">
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Subject}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding AuthorName}"
                                           Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" FontSize="12" />

                                <TextBlock Grid.Column="3" Text="{Binding DateDisplay}"
                                           ToolTip.Tip="{Binding DateTooltip}"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" FontSize="12" />

                                <TextBlock Grid.Column="4" Text="{Binding ShortSha}"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource DimBrush}"
                                           VerticalAlignment="Center" FontSize="11.5" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Row="1" Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch" />

                <!-- Detail pane: metadata + file list on the left, diff on the right -->
                <Grid Grid.Row="2" ColumnDefinitions="320,4,*"
                      Background="{StaticResource PanelBackgroundBrush}"
                      IsVisible="{Binding Detail, Converter={x:Static ObjectConverters.IsNotNull}}">

                    <!-- Rows rather than a DockPanel: a long commit message must scroll inside its
                         own band instead of pushing the changed-file list off the bottom. -->
                    <Grid Grid.Column="0" DataContext="{Binding Detail}" x:DataType="vm:CommitDetailViewModel"
                          RowDefinitions="Auto,Auto,*">
                        <!-- Commit metadata -->
                        <Border Grid.Row="0" Padding="12,10" MaxHeight="220"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <SelectableTextBlock Text="{Binding Body}"
                                                     IsVisible="{Binding HasBody}"
                                                     TextWrapping="Wrap"
                                                     Foreground="{StaticResource MutedBrush}"
                                                     FontSize="12" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding AuthorLine}"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11.5" />
                                <TextBlock Text="{Binding AuthoredOn}"
                                           Foreground="{StaticResource DimBrush}" FontSize="11.5" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <SelectableTextBlock Text="{Binding Sha}"
                                                         FontFamily="{StaticResource MonoFont}"
                                                         Foreground="{StaticResource DimBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        </Border>

                        <!-- Changed files -->
                        <Border Grid.Row="1" Padding="12,6">
                            <TextBlock Text="{Binding FileCountDisplay}" Classes="sectionheader" />
                        </Border>

                        <ListBox Grid.Row="2" Name="FileList" Classes="flat"
                                 ItemsSource="{Binding Files}"
                                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:FileChangeViewModel">
                                    <Grid ColumnDefinitions="16,*" ToolTip.Tip="{Binding ToolTip}">
                                        <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}"
                                                   Classes="status"
                                                   Classes.added="{Binding IsAdded}"
                                                   Classes.deleted="{Binding IsDeleted}"
                                                   Classes.renamed="{Binding IsRenamed}"
                                                   Classes.conflict="{Binding IsConflict}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11.5" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding FileName}"
                                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                                            <TextBlock Text="{Binding Directory}"
                                                       IsVisible="{Binding HasDirectory}"
                                                       Foreground="{StaticResource DimBrush}"
                                                       TextTrimming="CharacterEllipsis" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <GridSplitter Grid.Column="1" Background="{StaticResource BorderBrush}" />

                    <!-- Diff -->
                    <Border Grid.Column="2" Background="{StaticResource RowBackgroundBrush}">
                        <ListBox Classes="diff"
                                 ItemsSource="{Binding DiffLines}"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionMode="Single"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:DiffLineViewModel">
                                    <Border Classes="diffline"
                                            Classes.added="{Binding IsAdded}"
                                            Classes.removed="{Binding IsRemoved}"
                                            Classes.hunk="{Binding IsHunkHeader}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding OldNumber}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource DiffGutterBrush}"
                                                       FontSize="11.5" Padding="4,0,0,0" />
                                            <TextBlock Text="{Binding NewNumber}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Foreground="{StaticResource DiffGutterBrush}"
                                                       FontSize="11.5" Padding="6,0,8,0" />
                                            <TextBlock Text="{Binding Marker}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Classes="difftext"
                                                       Classes.added="{Binding IsAdded}"
                                                       Classes.removed="{Binding IsRemoved}"
                                                       FontSize="11.5" />
                                            <TextBlock Text="{Binding Text}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       Classes="difftext"
                                                       Classes.added="{Binding IsAdded}"
                                                       Classes.removed="{Binding IsRemoved}"
                                                       Classes.hunk="{Binding IsHunkHeader}"
                                                       Classes.header="{Binding IsHeader}"
                                                       FontSize="11.5" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
