<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitFork.App.ViewModels"
             xmlns:controls="using:GitFork.App.Controls"
             xmlns:core="using:GitFork.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="400"
             x:Class="GitFork.App.Views.DiffView"
             x:DataType="vm:DiffViewModel">

    <Grid RowDefinitions="Auto,*" Background="{StaticResource RowBackgroundBrush}">

        <!-- Presentation options -->
        <Border Grid.Row="0" Padding="8,4"
                Background="{StaticResource PanelBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="0">
                    <RadioButton Name="UnifiedToggle" Content="Unified" GroupName="DiffMode"
                                 FontSize="11.5" VerticalAlignment="Center"
                                 IsChecked="{Binding IsUnified, Mode=OneWay}"
                                 IsCheckedChanged="OnUnifiedChecked" />
                    <RadioButton Name="SideBySideToggle" Content="Side by side" GroupName="DiffMode"
                                 FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                 IsChecked="{Binding IsSideBySide, Mode=OneWay}"
                                 IsCheckedChanged="OnSideBySideChecked" />
                </StackPanel>

                <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,2" />

                <TextBlock Text="Context" VerticalAlignment="Center" FontSize="11.5"
                           Foreground="{StaticResource MutedBrush}" />
                <!-- Wide enough that the value itself is visible, not just the spinner arrows. -->
                <NumericUpDown Name="ContextInput" Value="{Binding ContextLines, Mode=TwoWay}"
                               Minimum="0" Maximum="50" Increment="1"
                               Width="120" FormatString="0"
                               FontSize="11.5" VerticalAlignment="Center" />

                <ComboBox Name="WhitespaceSelector" Width="190" FontSize="11.5"
                          VerticalAlignment="Center"
                          SelectedIndex="0" SelectionChanged="OnWhitespaceChanged">
                    <ComboBoxItem Content="Show whitespace changes" />
                    <ComboBoxItem Content="Ignore whitespace changes" />
                    <ComboBoxItem Content="Ignore all whitespace" />
                    <ComboBoxItem Content="Ignore blank lines" />
                </ComboBox>

                <CheckBox Name="SyntaxToggle" Content="Syntax" FontSize="11.5"
                          IsChecked="{Binding ShowSyntaxHighlighting, Mode=TwoWay}" />
                <CheckBox Name="WordToggle" Content="Word diff" FontSize="11.5"
                          IsChecked="{Binding ShowWordHighlighting, Mode=TwoWay}" />
            </StackPanel>
        </Border>

        <!-- Nothing to show -->
        <TextBlock Grid.Row="1" Name="EmptyLabel"
                   Text="{Binding EmptyMessage}"
                   IsVisible="{Binding HasEmptyMessage}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" />

        <!-- Image diff -->
        <Grid Grid.Row="1" Name="ImagePane" ColumnDefinitions="*,*"
              IsVisible="{Binding HasImage}" Margin="12">
            <StackPanel Grid.Column="0" Spacing="6" DataContext="{Binding Image}"
                        x:DataType="vm:ImageDiffViewModel">
                <TextBlock Text="Before" Classes="sectionheader" />
                <Image Source="{Binding Before}" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Top" MaxHeight="400" />
                <TextBlock Text="{Binding BeforeCaption}" FontSize="11"
                           Foreground="{StaticResource DimBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" DataContext="{Binding Image}"
                        x:DataType="vm:ImageDiffViewModel">
                <TextBlock Text="After" Classes="sectionheader" />
                <Image Source="{Binding After}" Stretch="Uniform"
                       HorizontalAlignment="Left" VerticalAlignment="Top" MaxHeight="400" />
                <TextBlock Text="{Binding AfterCaption}" FontSize="11"
                           Foreground="{StaticResource DimBrush}" />
            </StackPanel>
        </Grid>

        <!-- Unified -->
        <ListBox Grid.Row="1" Name="UnifiedList" Classes="diff"
                 ItemsSource="{Binding UnifiedRows}"
                 IsVisible="{Binding IsUnified}"
                 Background="Transparent" BorderThickness="0"
                 SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:UnifiedRowViewModel">
                    <Border Classes="diffline"
                            Classes.added="{Binding IsAdded}"
                            Classes.removed="{Binding IsRemoved}"
                            Classes.hunk="{Binding IsHunkHeader}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding OldNumber}" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource DiffGutterBrush}" FontSize="11.5"
                                       Padding="4,0,0,0" IsVisible="{Binding !IsHunkHeader}" />
                            <TextBlock Text="{Binding NewNumber}" FontFamily="{StaticResource MonoFont}"
                                       Foreground="{StaticResource DiffGutterBrush}" FontSize="11.5"
                                       Padding="6,0,8,0" IsVisible="{Binding !IsHunkHeader}" />
                            <TextBlock Text="{Binding Marker}" FontFamily="{StaticResource MonoFont}"
                                       Classes="difftext"
                                       Classes.added="{Binding IsAdded}"
                                       Classes.removed="{Binding IsRemoved}"
                                       FontSize="11.5" IsVisible="{Binding !IsHunkHeader}" />
                            <TextBlock Text="{Binding Text}" FontFamily="{StaticResource MonoFont}"
                                       Classes="difftext hunk" FontSize="11.5"
                                       IsVisible="{Binding IsHunkHeader}" />
                            <controls:DiffTextBlock Runs="{Binding Runs}"
                                                    FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                    Classes="difftext"
                                                    Classes.added="{Binding IsAdded}"
                                                    Classes.removed="{Binding IsRemoved}"
                                                    Classes.header="{Binding IsHeader}"
                                                    IsVisible="{Binding !IsHunkHeader}"
                                                    ShowSyntax="{Binding $parent[UserControl].((vm:DiffViewModel)DataContext).ShowSyntaxHighlighting}"
                                                    HighlightBrush="{StaticResource WordHighlightBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Side by side -->
        <ListBox Grid.Row="1" Name="SideBySideList" Classes="diff"
                 ItemsSource="{Binding SideBySideRows}"
                 IsVisible="{Binding IsSideBySide}"
                 Background="Transparent" BorderThickness="0"
                 SelectionMode="Multiple"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="vm:SideBySideRowViewModel">
                    <Grid ColumnDefinitions="*,1,*">
                        <TextBlock Grid.Column="0" Grid.ColumnSpan="3"
                                   Text="{Binding HunkHeader}"
                                   IsVisible="{Binding IsHunkHeader}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   Classes="difftext hunk" Padding="4,0" />

                        <Border Grid.Column="0" Classes="diffline"
                                Classes.removed="{Binding Left.IsRemoved}"
                                IsVisible="{Binding !IsHunkHeader}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Left.Number}" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource DiffGutterBrush}" FontSize="11.5"
                                           Padding="4,0,8,0" />
                                <controls:DiffTextBlock Runs="{Binding Left.Runs}"
                                                        FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                        Classes="difftext"
                                                        Classes.removed="{Binding Left.IsRemoved}"
                                                        ShowSyntax="{Binding $parent[UserControl].((vm:DiffViewModel)DataContext).ShowSyntaxHighlighting}"
                                                        HighlightBrush="{StaticResource WordRemovedHighlightBrush}" />
                            </StackPanel>
                        </Border>

                        <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}"
                                   IsVisible="{Binding !IsHunkHeader}" />

                        <Border Grid.Column="2" Classes="diffline"
                                Classes.added="{Binding Right.IsAdded}"
                                IsVisible="{Binding !IsHunkHeader}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Right.Number}" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{StaticResource DiffGutterBrush}" FontSize="11.5"
                                           Padding="4,0,8,0" />
                                <controls:DiffTextBlock Runs="{Binding Right.Runs}"
                                                        FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                                        Classes="difftext"
                                                        Classes.added="{Binding Right.IsAdded}"
                                                        ShowSyntax="{Binding $parent[UserControl].((vm:DiffViewModel)DataContext).ShowSyntaxHighlighting}"
                                                        HighlightBrush="{StaticResource WordAddedHighlightBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
