<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitFork.App.ViewModels"
        xmlns:controls="using:GitFork.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="GitFork.App.Views.FileTreeWindow"
        x:DataType="vm:FileTreeViewModel"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Title}">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="10,4"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Name="TreeStatus" Text="{Binding StatusText}"
                       Foreground="{DynamicResource MutedBrush}" FontSize="11" />
        </Border>

        <Grid ColumnDefinitions="340,4,*">
            <TreeView Grid.Column="0" Name="FileTree"
                      ItemsSource="{Binding Roots}"
                      SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                      Background="{DynamicResource PanelBackgroundBrush}" BorderThickness="0">
                <TreeView.ItemTemplate>
                    <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
                        <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{Binding Path}">
                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                       TextTrimming="CharacterEllipsis" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Margin="10,0,0,0"
                                       Foreground="{DynamicResource DimBrush}" FontSize="11" />
                        </Grid>
                    </TreeDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Column="2" Background="{DynamicResource RowBackgroundBrush}">
                <TextBlock Name="ContentMessageLabel"
                           Text="{Binding ContentMessage}"
                           IsVisible="{Binding HasContentMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" />

                <ListBox Name="ContentList" Classes="diff"
                         ItemsSource="{Binding ContentLines}"
                         IsVisible="{Binding !HasContentMessage}"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:FileLineViewModel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NumberDisplay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{DynamicResource DiffGutterBrush}"
                                           Padding="4,0,10,0" />
                                <controls:DiffTextBlock Runs="{Binding Runs}"
                                                        FontFamily="{StaticResource MonoFont}"
                                                        FontSize="11.5" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
