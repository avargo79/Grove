<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitFork.App.ViewModels"
             xmlns:views="using:GitFork.App.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="340"
             x:Class="GitFork.App.Views.CommitDetailView"
             x:DataType="vm:CommitDetailViewModel"
             AttachedToVisualTree="OnAttachedToTree">

    <Grid ColumnDefinitions="320,4,*" Background="{DynamicResource PanelBackgroundBrush}">

        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <Border Grid.Row="0" Padding="12,10" MaxHeight="220"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <SelectableTextBlock Text="{Binding Body}"
                                             IsVisible="{Binding HasBody}"
                                             TextWrapping="Wrap"
                                             Foreground="{DynamicResource MutedBrush}"
                                             FontSize="12" Margin="0,2" />
                        <TextBlock Text="{Binding AuthorLine}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11.5" />
                        <TextBlock Text="{Binding AuthoredOn}"
                                   Foreground="{DynamicResource DimBrush}" FontSize="11.5" />
                        <SelectableTextBlock Text="{Binding Sha}"
                                             FontFamily="{StaticResource MonoFont}"
                                             Foreground="{DynamicResource DimBrush}" FontSize="11" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="1" Padding="12,6">
                <TextBlock Text="{Binding FileCountDisplay}" Classes="sectionheader" />
            </Border>

            <ListBox Grid.Row="2" Name="FileList" Classes="flat"
                     ItemsSource="{Binding Files}"
                     SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:FileChangeViewModel">
                        <Grid ColumnDefinitions="16,*" ToolTip.Tip="{Binding ToolTip}">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Blame this file…"
                                              Click="OnBlameClicked" />
                                    <MenuItem Header="File history…"
                                              Click="OnFileHistoryClicked" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}"
                                       Classes="status"
                                       Classes.added="{Binding IsAdded}"
                                       Classes.deleted="{Binding IsDeleted}"
                                       Classes.renamed="{Binding IsRenamed}"
                                       Classes.conflict="{Binding IsConflict}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                <TextBlock Text="{Binding Directory}"
                                           IsVisible="{Binding HasDirectory}"
                                           Foreground="{DynamicResource DimBrush}"
                                           TextTrimming="CharacterEllipsis" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" Background="{DynamicResource BorderBrush}" />

        <views:DiffView Grid.Column="2" DataContext="{Binding Diff}" />

    </Grid>
</UserControl>
