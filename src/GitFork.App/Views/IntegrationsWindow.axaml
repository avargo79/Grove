<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitFork.App.ViewModels"
        xmlns:core="using:GitFork.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
        x:Class="GitFork.App.Views.IntegrationsWindow"
        x:DataType="vm:IntegrationsViewModel"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Width="760" Height="560"
        WindowStartupLocation="CenterOwner"
        Title="Submodules and LFS">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="12,6"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" Name="IntegrationsStatus" Text="{Binding StatusText}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Margin="0,0,10,0"
                           IsVisible="{Binding IsUpdating}" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center"
                           MaxWidth="260" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Name="UpdateSubmodulesButton" Content="Update Submodules"
                        Command="{Binding UpdateSubmodulesCommand}"
                        IsVisible="{Binding HasSubmodules}" />
            </Grid>
        </Border>

        <ScrollViewer>
            <StackPanel Margin="14" Spacing="14">

                <TextBlock Text="Submodules" Classes="sectionheader" />
                <TextBlock Name="NoSubmodulesLabel"
                           Text="This repository has no submodules."
                           IsVisible="{Binding HasNoSubmodules}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                <ItemsControl Name="SubmoduleList" ItemsSource="{Binding Submodules}"
                              IsVisible="{Binding HasSubmodules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:SubmoduleViewModel">
                            <Grid ColumnDefinitions="*,90,180" Height="24">
                                <TextBlock Grid.Column="0" Text="{Binding Path}"
                                           VerticalAlignment="Center" FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding ShortSha}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                           Foreground="{DynamicResource DimBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StateDisplay}" FontSize="11.5"
                                           VerticalAlignment="Center"
                                           Classes="substate"
                                           Classes.attention="{Binding NeedsAttention}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Git LFS" Classes="sectionheader" Margin="0,8,0,0" />
                <TextBlock Name="NoLfsLabel"
                           Text="git-lfs is not set up for this repository."
                           IsVisible="{Binding !IsLfsAvailable}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12" />

                <StackPanel IsVisible="{Binding IsLfsAvailable}" Spacing="8">
                    <TextBlock Text="Tracked files" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}" />
                    <ItemsControl Name="LfsFileList" ItemsSource="{Binding LfsFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="core:LfsFile">
                                <Grid ColumnDefinitions="*,110" Height="22">
                                    <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="12"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource DimBrush}"
                                               Text="{Binding IsDownloaded, StringFormat='downloaded: {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Locks" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="No locks are held." FontSize="12"
                               IsVisible="{Binding !HasLfsLocks}"
                               Foreground="{DynamicResource DimBrush}" />
                    <ItemsControl Name="LfsLockList" ItemsSource="{Binding LfsLocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="core:LfsLock">
                                <Grid ColumnDefinitions="*,160" Height="22">
                                    <TextBlock Grid.Column="0" Text="{Binding Path}" FontSize="12"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Owner}" FontSize="11"
                                               Foreground="{DynamicResource DimBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
