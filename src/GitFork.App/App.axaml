<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitFork.App.App"
             xmlns:local="using:GitFork.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <!--
              Every colour lives in both dictionaries so the whole app can switch at runtime.
              The keys are identical; only the values differ, which is what lets the rest of the
              XAML stay theme-agnostic.
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1E1F22" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#26282C" />
                    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#1E1F22" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#2B2D30" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#393B40" />

                    <SolidColorBrush x:Key="ForegroundBrush" Color="#DFE1E5" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#8B8F96" />
                    <SolidColorBrush x:Key="DimBrush" Color="#6B7079" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#3574F0" />

                    <SolidColorBrush x:Key="AddedBrush" Color="#6BC46D" />
                    <SolidColorBrush x:Key="DeletedBrush" Color="#F0736A" />
                    <SolidColorBrush x:Key="ModifiedBrush" Color="#D9A343" />
                    <SolidColorBrush x:Key="RenamedBrush" Color="#7C9EE8" />
                    <SolidColorBrush x:Key="ConflictBrush" Color="#E05D7C" />

                    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#16321F" />
                    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#3A1D1D" />
                    <SolidColorBrush x:Key="DiffHunkBackgroundBrush" Color="#21262E" />
                    <SolidColorBrush x:Key="DiffGutterBrush" Color="#5A5F68" />
                    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#9BDCA0" />
                    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#F5A6A0" />

                    <SolidColorBrush x:Key="WordHighlightBrush" Color="#3F4A5A" />
                    <SolidColorBrush x:Key="WordAddedHighlightBrush" Color="#2A6B36" />
                    <SolidColorBrush x:Key="WordRemovedHighlightBrush" Color="#7A2F2F" />

                    <SolidColorBrush x:Key="BadgeHeadBrush" Color="#2E5AAC" />
                    <SolidColorBrush x:Key="BadgeLocalBrush" Color="#3A4A63" />
                    <SolidColorBrush x:Key="BadgeRemoteBrush" Color="#3E4148" />
                    <SolidColorBrush x:Key="BadgeTagBrush" Color="#5A4A2A" />
                    <SolidColorBrush x:Key="BadgeUnreachableBrush" Color="#6B3A2A" />

                    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#3A2A18" />
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#33FFFFFF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#F3F4F6" />
                    <SolidColorBrush x:Key="RowBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#ECEEF1" />
                    <SolidColorBrush x:Key="BorderBrush" Color="#D0D3D9" />

                    <SolidColorBrush x:Key="ForegroundBrush" Color="#1F2328" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5C636D" />
                    <SolidColorBrush x:Key="DimBrush" Color="#858C96" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#1F5FD8" />

                    <SolidColorBrush x:Key="AddedBrush" Color="#1F7A32" />
                    <SolidColorBrush x:Key="DeletedBrush" Color="#C0392B" />
                    <SolidColorBrush x:Key="ModifiedBrush" Color="#9A6700" />
                    <SolidColorBrush x:Key="RenamedBrush" Color="#2F5FB5" />
                    <SolidColorBrush x:Key="ConflictBrush" Color="#B02A50" />

                    <SolidColorBrush x:Key="DiffAddedBackgroundBrush" Color="#E4F6E8" />
                    <SolidColorBrush x:Key="DiffRemovedBackgroundBrush" Color="#FBE7E7" />
                    <SolidColorBrush x:Key="DiffHunkBackgroundBrush" Color="#EDF1F7" />
                    <SolidColorBrush x:Key="DiffGutterBrush" Color="#9AA1AB" />
                    <SolidColorBrush x:Key="DiffAddedTextBrush" Color="#12602A" />
                    <SolidColorBrush x:Key="DiffRemovedTextBrush" Color="#A02020" />

                    <SolidColorBrush x:Key="WordHighlightBrush" Color="#CBD9EE" />
                    <SolidColorBrush x:Key="WordAddedHighlightBrush" Color="#A8E4B6" />
                    <SolidColorBrush x:Key="WordRemovedHighlightBrush" Color="#F2B8B8" />

                    <SolidColorBrush x:Key="BadgeHeadBrush" Color="#BFD6FA" />
                    <SolidColorBrush x:Key="BadgeLocalBrush" Color="#DCE3EE" />
                    <SolidColorBrush x:Key="BadgeRemoteBrush" Color="#E4E6EA" />
                    <SolidColorBrush x:Key="BadgeTagBrush" Color="#F5E4BF" />
                    <SolidColorBrush x:Key="BadgeUnreachableBrush" Color="#F6D5C4" />

                    <SolidColorBrush x:Key="BannerBackgroundBrush" Color="#FDF3DC" />
                    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#22000000" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>

            <FontFamily x:Key="MonoFont">Cascadia Mono,Menlo,Consolas,DejaVu Sans Mono,monospace</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Commit list rows: flat, tight, keyboard-friendly. -->
        <Style Selector="ListBox.commits ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="ListBox.flat ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- Diff rows must not respond to hover/selection: the diff is read-only text. -->
        <Style Selector="ListBox.diff ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Ref badge colours by kind. -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource BadgeLocalBrush}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge.head">
            <Setter Property="Background" Value="{DynamicResource BadgeHeadBrush}" />
        </Style>
        <Style Selector="Border.badge.remote">
            <Setter Property="Background" Value="{DynamicResource BadgeRemoteBrush}" />
        </Style>
        <Style Selector="Border.badge.unreachable">
            <Setter Property="Background" Value="{DynamicResource BadgeUnreachableBrush}" />
        </Style>
        <Style Selector="Border.badge.tag">
            <Setter Property="Background" Value="{DynamicResource BadgeTagBrush}" />
        </Style>

        <!-- File status letters. -->
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.added">
            <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.deleted">
            <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.renamed">
            <Setter Property="Foreground" Value="{DynamicResource RenamedBrush}" />
        </Style>
        <Style Selector="TextBlock.status.conflict">
            <Setter Property="Foreground" Value="{DynamicResource ConflictBrush}" />
        </Style>

        <!-- Diff line backgrounds. -->
        <Style Selector="Border.diffline.added">
            <Setter Property="Background" Value="{DynamicResource DiffAddedBackgroundBrush}" />
        </Style>
        <Style Selector="Border.diffline.removed">
            <Setter Property="Background" Value="{DynamicResource DiffRemovedBackgroundBrush}" />
        </Style>
        <Style Selector="Border.diffline.hunk">
            <Setter Property="Background" Value="{DynamicResource DiffHunkBackgroundBrush}" />
        </Style>

        <Style Selector="TextBlock.difftext.added">
            <Setter Property="Foreground" Value="{DynamicResource DiffAddedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.difftext.removed">
            <Setter Property="Foreground" Value="{DynamicResource DiffRemovedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.difftext.hunk">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.difftext.header">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>

        <!-- Inline text actions: a button that reads as a link, not a chrome button. -->
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>

        <!-- Operation feedback in the status bar: neutral by default, red when it failed. -->
        <Style Selector="TextBlock.opstatus">
            <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
        </Style>
        <Style Selector="TextBlock.opstatus.error">
            <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}" />
        </Style>
        <Style Selector="TextBlock.opstatus.conflict">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <!-- Rebase plan rows: the chosen action changes how the subject reads. -->
        <Style Selector="TextBlock.rebasesubject.dropped">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}" />
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="TextBlock.rebasesubject.combined">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.rebasesubject.stops">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <Style Selector="TextBlock.reflogaction">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.reflogaction.destructive">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <!-- Signature indicators. -->
        <Style Selector="TextBlock.signature">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>
        <Style Selector="TextBlock.signature.good">
            <Setter Property="Foreground" Value="{DynamicResource AddedBrush}" />
        </Style>
        <Style Selector="TextBlock.signature.bad">
            <Setter Property="Foreground" Value="{DynamicResource DeletedBrush}" />
        </Style>

        <Style Selector="TextBlock.substate">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.substate.attention">
            <Setter Property="Foreground" Value="{DynamicResource ModifiedBrush}" />
        </Style>

        <Style Selector="TextBlock.sectionheader">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>
</Application>
