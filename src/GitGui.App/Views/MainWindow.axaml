<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitGui.App.ViewModels"
        xmlns:views="using:GitGui.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="GitGui.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        Width="1400" Height="900"
        Title="git-gui">

    <Design.DataContext>
        <vm:ShellViewModel />
    </Design.DataContext>

    <!--
      Bindings live here rather than on individual controls so every shortcut works wherever
      focus happens to be, and the palette lists the same set (see CommandCatalog).
    -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenRepositoryCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseRepositoryCommand}"
                    CommandParameter="{Binding SelectedRepository}" />
        <KeyBinding Gesture="F5" Command="{Binding SelectedRepository.RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+F" Command="{Binding SelectedRepository.Commands.FetchCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+L" Command="{Binding SelectedRepository.Commands.PullCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+P" Command="{Binding SelectedRepository.Commands.PushCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SelectedRepository.Commands.StashPushCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding SelectedRepository.Commands.CreateBranchCommand}" />
        <KeyBinding Gesture="Ctrl+G" Command="{Binding SelectedRepository.SelectWorkingCopyCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding SelectedRepository.ClearFilterCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- Shell bar: everything that is not about one particular repository -->
        <Border DockPanel.Dock="Top" Padding="10,6"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Name="OpenRepositoryButton" Content="Open Repository…"
                        Command="{Binding OpenRepositoryCommand}" />

                <Button Grid.Column="1" Name="RecentButton" Content="Recent" Margin="6,0,0,0"
                        IsEnabled="{Binding Recent.Count}">
                    <Button.Flyout>
                        <MenuFlyout ItemsSource="{Binding Recent}">
                            <MenuFlyout.ItemTemplate>
                                <DataTemplate DataType="vm:RecentRepository">
                                    <TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Path}" />
                                </DataTemplate>
                            </MenuFlyout.ItemTemplate>
                            <MenuFlyout.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="Command"
                                            Value="{Binding $parent[Window].((vm:ShellViewModel)DataContext).OpenRecentCommand}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </ControlTheme>
                            </MenuFlyout.ItemContainerTheme>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <TextBlock Grid.Column="2" Name="ShellStatus" Text="{Binding StatusMessage}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11.5" />

                <Button Grid.Column="3" Name="CommandPaletteButton" Content="Commands  ⌘K"
                        Click="OnCommandPaletteClicked" Margin="0,0,6,0" />
                <Button Grid.Column="4" Name="SettingsButton" Content="Settings…"
                        Click="OnSettingsClicked" />
            </Grid>
        </Border>

        <!-- Nothing open yet -->
        <StackPanel Name="EmptyState" IsVisible="{Binding HasNoRepositories}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="No repository open"
                       FontSize="16" HorizontalAlignment="Center" />
            <TextBlock Text="Open one to get started, or pick a recent repository."
                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>

        <TabControl Name="RepositoryTabs"
                    ItemsSource="{Binding Repositories}"
                    SelectedItem="{Binding SelectedRepository, Mode=TwoWay}"
                    IsVisible="{Binding HasRepositories}"
                    Padding="0">
            <TabControl.ItemTemplate>
                <DataTemplate DataType="vm:MainViewModel">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding RepositoryName}" VerticalAlignment="Center" />
                        <Button Content="✕" Classes="link" FontSize="10"
                                ToolTip.Tip="Close this repository"
                                Command="{Binding $parent[Window].((vm:ShellViewModel)DataContext).CloseRepositoryCommand}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate DataType="vm:MainViewModel">
                    <views:RepositoryView />
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </DockPanel>
</Window>
